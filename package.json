{
  "name": "code-to-diagram",
  "version": "1.3.0",
  "description": "CTD Studio: a local-first code-to-diagram editor and MCP server",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ctd-mcp": "./mcp/dist/index.js"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && npm run mcp:build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false && tsc --noEmit -p mcp/tsconfig.json",
    "test": "playwright test",
    "test:parsers": "node --test tests/parsers.test.mjs",
    "test:sidecar": "node --test tests/sidecar.test.mjs",
    "test:render": "node scripts/render-diagram.mjs --input tests/fixtures/sequence-golden/auth.mmd --out test-results/sequence-golden.svg",
    "mcp:build": "vite build --config mcp/vite.config.ts && node -e \"import('node:fs').then(fs => fs.chmodSync('mcp/dist/index.js', 0o755))\"",
    "mcp:test": "node --test mcp/tests/server.test.mjs",
    "prepare": "node -e \"import('node:fs').then(fs => { if (fs.existsSync('node_modules/vite')) { import('node:child_process').then(cp => cp.execSync('npm run mcp:build', { stdio: 'inherit' })); } })\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cxernlol/code-to-diagram.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "Elastic-2.0",
  "bugs": {
    "url": "https://github.com/cxernlol/code-to-diagram/issues"
  },
  "homepage": "https://github.com/cxernlol/code-to-diagram#readme",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vercel/analytics": "^2.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "animejs": "^4.5.0",
    "codemirror": "^6.0.2",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "dompurify": "^3.4.18",
    "framer-motion": "^14.14.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.73.0",
    "peerjs": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
